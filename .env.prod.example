# Production parametrləri (sirr OLMAYANLAR). Kopyalayın: cp .env.prod.example .env.prod
# Sirlər (tokenlər, açarlar, parollar) burada deyil, ./secrets/<ad> fayllarındadır: docs/deploy.md

ORG_NAME=Əmək və Əhalinin Sosial Müdafiəsi Nazirliyi
HOTLINE_TEXT=Qaynar xətt: 142
CITIZEN_BOT_USERNAME=
STAFF_BOT_USERNAME=

# Hüquqşünasın təyin etdiyi saxlama müddəti (il). Boşdursa təmizlik işləmir
RETENTION_YEARS=

# Embedding (lokal, Ollama konteyneri)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3

# Ehtiyat nüsxə: saat (Bakı) və neçə gün saxlanılır
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14

RATE_LIMIT_PER_MINUTE=20
FAQ_CACHE_HOURS=24

# LangSmith: yalnız hüquqi razılıqdan sonra (maskalanmış məlumat xaricə gedir)
LANGSMITH_TRACING=false
