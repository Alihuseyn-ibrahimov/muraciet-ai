# İnkişaf mühiti üçün nümunə: cp .env.example .env
# Production-da sirlər bu faylda deyil, ./secrets/ fayllarındadır (docker-compose.prod.yml).

# ---- Təşkilat ----
ORG_NAME=Əmək və Əhalinin Sosial Müdafiəsi Nazirliyi
# Boş qalsa bot qaynar xətti göstərmir. Dırnaq işlətməyin (dotenv dırnaqdan sonrakını atır).
HOTLINE_TEXT=Çağrı mərkəzi: 142

# ---- LLM ----
# Hər agentin provayderi və modeli config/agents.yaml-dadır
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# vLLM üçün: OPENAI_BASE_URL=http://gpu-server:8001/v1
OLLAMA_BASE_URL=http://ollama:11434

# ---- Embeddings (lokal Ollama: bilik bazası serverdən çıxmır) ----
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
# Hostdakı əmrlər üçün (manage ingest, eval); konteynerlər docker-compose.yml-dəki ünvanı işlədir
EMBEDDINGS_URL=http://127.0.0.1:11435

# ---- Verilənlər bazası (muraciet_v2) ----
# Bu ünvanlar hostdakı əmrlər (venv, pytest, manage) üçündür: 127.0.0.1:55432 (docker-compose.override.yml).
# Konteynerlər docker-compose.yml-də postgres:5432 ünvanını alır.
APP_DATABASE_URL=postgresql+psycopg://muraciet_app:APP_DB_PASSWORD_BURAYA@127.0.0.1:55432/muraciet_v2
MIGRATION_DATABASE_URL=postgresql+psycopg://muraciet:muraciet@127.0.0.1:55432/muraciet_v2
# Rolların parolları: ən azı 16 simvol, yalnız A-Z a-z 0-9 _ - (python -c "import secrets; print(secrets.token_urlsafe(24))")
APP_DB_PASSWORD=
N8N_DB_PASSWORD=
REDIS_URL=redis://127.0.0.1:56379/0

# ---- API açarları ----
# Botların runner-ləri və n8n API-yə bu açarla müraciət edir (uzun təsadüfi sətir)
SERVICE_TOKEN=
# Admin API və MCP (yalnız oxuma); boş qalsa admin API bağlıdır
ADMIN_API_KEY=

# ---- Şəxsi məlumatların şifrələnməsi ----
# Fernet açarları, vergüllə ayrılır; birincisi əsasdır. Ehtiyat nüsxəsini ayrıca saxlayın! Yaratmaq üçün:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEYS=
# Axtarış heşləri üçün ayrıca açar (uzun təsadüfi sətir)
HMAC_KEY=
# Boş qalsa saxlama müddəti təmizliyi işləmir (dəyəri hüquq şöbəsi müəyyən edir)
RETENTION_YEARS=
# Ehtiyat nüsxə (backup servisi): saat (Bakı) və neçə gün saxlanılır
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14

# ---- Telegram ----
# Vətəndaş botu (köhnə ad TELEGRAM_BOT_TOKEN də qəbul olunur)
CITIZEN_BOT_TOKEN=
CITIZEN_BOT_USERNAME=
# Əməkdaş botu (@BotFather-da ayrıca bot)
STAFF_BOT_TOKEN=
STAFF_BOT_USERNAME=

# ---- Təhlükəsizlik ----
USE_NEMO_GUARDRAILS=false
RATE_LIMIT_PER_MINUTE=20
# Eyni ümumi sualın (dialoqsuz, şəxsi məlumatsız) cavabı Redis-də saxlanır, saat; 0 söndürür
FAQ_CACHE_HOURS=24

# ---- Observability (LangSmith, Mərhələ 2) ----
# Yalnız maskalanmış LLM çağırışları izlənir, qrafın avtomatik izlənməsi kodda söndürülüb (app/observability.py).
# İstehsalda açmaq üçün hüquqi razılıq lazımdır (docs/pilot-checklist.md)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=muraciet-ai
